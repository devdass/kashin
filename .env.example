# ── Required ────────────────────────────────────────────────────────────────
# Encryption key used to encrypt Akahu tokens and any LLM API keys at rest.
# Generate with: openssl rand -base64 32
# Keep a secure backup — stored tokens cannot be recovered if this is lost.
AKAHU_ENCRYPTION_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Path to the SQLite data directory. Defaults to ./data in the project folder.
# AKAHU_DATA_DIRECTORY=/absolute/path/to/data

# Set to "true" to allow session cookies over plain HTTP (e.g. accessing on a
# LAN IP). Modern browsers treat http://localhost as secure, so local dev works
# with "false" (the default). Leave unset unless you know you need it.
# AKAHU_ALLOW_INSECURE_HTTP=false

# Secret for the self-hosted cron sync endpoint (POST /api/internal/sync with
# "Authorization: Bearer <secret>"). Only needed if you schedule automatic syncs.
# Generate with: openssl rand -hex 24
# CRON_SECRET=

# ── Self-hosting / Vercel proxy (optional) ──────────────────────────────────
# If you run a public deployment that fronts a self-hosted origin, set these so
# the deployed app proxies requests and allows server actions from that origin.
# KASHIN_ORIGIN_URL=https://your-origin.example.com
# KASHIN_ALLOWED_ORIGIN=https://your-app.vercel.app